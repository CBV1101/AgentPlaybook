# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional alias used by newer Supabase docs. If set, it is used when
# NEXT_PUBLIC_SUPABASE_ANON_KEY is empty.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Copy this file to .env.local and fill in real values when you are ready:
#   cp .env.example .env.local
#
# Until those keys are set, the app runs on local mock data that matches
# supabase/migrations. Apply those SQL files to your project before going live.

# Cloudflare Stream (required for live video uploads). Without these, videos
# are stored locally in .local/media during mock/dev.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
