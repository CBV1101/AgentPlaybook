# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local

# Supabase project settings (Project Settings → API)
# Required in production. Missing or invalid values fail the process closed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional alias used by newer Supabase docs. If set, it is used when
# NEXT_PUBLIC_SUPABASE_ANON_KEY is empty.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used to mint short-lived signed URLs for private report photos.
# Never prefix this with NEXT_PUBLIC_. Never send it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Development-only local JSON mock store (.local/mock-db.json).
# Production ignores this flag. Missing Supabase env in production is an error,
# not mock mode. See docs/development-data.md.
# FIRSTHAND_USE_MOCK=1

# Cloudflare Stream (required for live video uploads). Without these, recorded
# videos may use local files under .local/media during development only.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
