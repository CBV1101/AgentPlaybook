# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# macOS
.DS_Store

# keys and certificates
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets. Never commit .env.local, API keys, Supabase secrets, or Cloudflare credentials.
.env
.env.local
.env.*
!.env.example

# supabase local artifacts
supabase/.temp/
supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.cursor/
*.log

# Local mock database and generated media (photos/videos stored without Supabase/Cloudflare)
.local/
